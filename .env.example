# CALIBRE - Variables d'environnement
# Copier ce fichier en .env et ajuster les valeurs

# Base de données PostgreSQL
DATABASE_URL=postgresql://calibre:calibre@localhost:5432/calibre

# Authentification JWT
JWT_SECRET=change-this-to-a-very-long-random-string
JWT_EXPIRES_IN=1h

# LLM (facultatif - le projet doit fonctionner SANS clé)
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Email (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=calibre@calibre.test

# Frontend / API
API_PORT=3000
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
NUXT_PUBLIC_API_BASE=http://localhost:3000

# Sécurité
RATE_LIMIT_MAX=60
EXPLANATION_MAX_LENGTH=1000
MIN_TEAM_SIZE_FOR_MATURITY=5
