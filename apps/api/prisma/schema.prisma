// Calibre - schéma Prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  learner
  manager
}

enum Technique {
  none
  deformed_statistic
  invented_quote
  fake_urgency
  dubious_source
  spoofed_sender
}

enum Verdict {
  reliable
  suspicious
}

enum ContentSource {
  llm
  fallback
}

enum ContentStatus {
  ready
  rejected
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users User[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id])
  teamId String

  answers        Answer[]
  skillRatings   SkillRating[]
  xapiStatements XapiStatement[]
}

model Content {
  id          String         @id @default(cuid())
  title       String
  body        String         @db.Text
  senderName  String
  isReliable  Boolean
  technique   Technique
  difficulty  Int            @default(1)
  highlights  Json           @default("[]")
  explanation String         @db.Text
  source      ContentSource
  status      ContentStatus  @default(ready)
  createdAt   DateTime       @default(now())

  answers Answer[]
}

model Answer {
  id                  String    @id @default(cuid())
  verdict             Verdict
  technique           Technique
  explanation         String    @db.Text
  highlights          Json      @default("[]")
  verdictCorrect      Boolean
  techniqueCorrect    Boolean
  explanationScore    Int?
  explanationFeedback Json?
  injectionFlag       Boolean   @default(false)
  createdAt           DateTime  @default(now())

  user      User    @relation(fields: [userId], references: [id])
  userId    String
  content   Content @relation(fields: [contentId], references: [id])
  contentId String

  xapiStatements XapiStatement[]
}

model SkillRating {
  id        String    @id @default(cuid())
  technique Technique
  rating    Int       @default(1000)
  updatedAt DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@unique([userId, technique])
}

model XapiStatement {
  id        String   @id @default(cuid())
  statement Json
  createdAt DateTime @default(now())

  user    User   @relation(fields: [userId], references: [id])
  userId  String
  answer  Answer @relation(fields: [answerId], references: [id])
  answerId String
}
